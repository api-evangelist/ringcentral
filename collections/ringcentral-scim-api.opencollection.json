          "http": {
            "method": "GET",
            "url": "https://platform.ringcentral.com/scim/v2/Schemas"
          },
          "docs": "Returns the list of schemas"
        },
        {
          "info": {
            "name": "Get Schema",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://platform.ringcentral.com/scim/v2/Schemas/:uri",
            "params": [
              {
                "name": "uri",
                "value": "",
                "type": "path",
                "description": "Schema URI"
              }
            ]
          },
          "docs": "Returns SCIM schema"
        },
        {
          "info": {
            "name": "Search/List Users",
