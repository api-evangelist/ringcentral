        {
          "id": "ea8fd6d2-c205-48e0-9adc-eb1ea8ba0db1",
          "name": "Get Conversation",
          "request": {
            "name": "Get Conversation",
            "description": {
              "content": "Returns information about the specified conversation, including the list of conversation participants. A conversation is an adhoc discussion between a particular set of users, not featuring any specific name or description; it is a chat of 'Group' type. If you add a person to the existing conversation, it creates a whole new conversation.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "team-messaging",
                "v1",
                "conversations",
                ":chatId"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "chatId",
                  "description": "(Required) Internal identifier of a conversation to be returned."
