        {
          "id": "c0156b23-b262-45c8-9110-29652df16264",
          "name": "Create/Open Conversation",
          "request": {
            "name": "Create/Open Conversation",
            "description": {
              "content": "Creates a new conversation or opens the existing one. If the conversation already exists, then its ID will be returned in response. A conversation is an adhoc discussion between a particular set of users, not featuring any specific name or description; it is a chat of 'Group' type. If you add a person to the existing conversation (group), it creates a whole new conversation.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "team-messaging",
                "v1",
                "conversations"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"members\": [\n    {\n      \"id\": \"<string>\",\n      \"email\": \"<email>\"\n    },\n    {\n      \"id\": \"<string>\",\n      \"email\": \"<email>\"\n    }\n  ]\n}",
