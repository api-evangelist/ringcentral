          "name": "List Conversations",
          "request": {
            "name": "List Conversations",
            "description": {
              "content": "Returns the list of conversations where the user is a member. All records in response are sorted by creation time of a conversation in ascending order. Conversation is a chat of the *Group* type.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "team-messaging",
                "v1",
                "conversations"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "recordCount",
                  "value": "30",
                  "description": "Number of conversations to be fetched by one request. The maximum value is 250, by default - 30"
                },
                {
                  "disabled": false,
                  "key": "pageToken",
                  "value": "<string>",
                  "description": "Pagination token."
