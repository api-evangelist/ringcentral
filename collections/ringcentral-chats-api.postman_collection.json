          "name": "Get Chat",
          "request": {
            "name": "Get Chat",
            "description": {
              "content": "Returns information about a chat by ID.\n\n**Note** 'Chat' is a general name for all types of threads including *Personal* (user's own me-chat), *Direct* (one on one chat), *Group* (chat of 3-15 participants without specific name), *Team* (chat of 2 and more participants, with a specific name), *Everyone* (company chat including all employees, with a specific name).\"\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "team-messaging",
                "v1",
                "chats",
                ":chatId"
              ],
              "host": [
                "{{baseUrl}}"
              ],
