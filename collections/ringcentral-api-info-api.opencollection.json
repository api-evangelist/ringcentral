{
  "opencollection": "1.0.0",
  "info": {
    "name": "RingCentral Adaptive Cards API Info API",
    "version": "1.0.58-20240529-47eda8bd"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://platform.ringcentral.com/restapi/oauth/authorize",
      "accessTokenUrl": "https://platform.ringcentral.com/restapi/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "API Info",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get API Versions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://platform.ringcentral.com/restapi"
          },
          "docs": "Returns current API version(s) and server info."
        },
        {
          "info": {
            "name": "Get Version Info",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://platform.ringcentral.com/restapi/:apiVersion",
            "params": [
              {
                "name": "apiVersion",
                "value": "",
                "type": "path",
                "description": "API version to be requested, for example 'v1.0'"
              }
            ]
          },
          "docs": "Returns current API version info by apiVersion."
        }
      ]
    }
  ],
  "bundled": true
}