          "name": "Get Call Recording Content",
          "request": {
            "name": "Get Call Recording Content",
            "description": {
              "content": "Returns media content of a call recording (`audio/mpeg` or `audio/wav`)\n\n**This API must be called via media API entry point, e.g. https://media.ringcentral.com**\n",
              "type": "text/plain"
            },
