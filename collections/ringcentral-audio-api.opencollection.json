                "value": "JohnDoe",
                "type": "path",
                "description": "Speaker identifier of enrolled speaker"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Add newer audio data to improve an existing speaker enrollment"
