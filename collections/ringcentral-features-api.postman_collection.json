              "body": "{\n  \"records\": [\n    {\n      \"id\": \"string\",\n      \"available\": false,\n      \"params\": [\n        {\n          \"name\": \"string\",\n          \"value\": \"string\"\n        },\n        {\n          \"name\": \"string\",\n          \"value\": \"string\"\n        }\n      ],\n      \"reason\": {\n        \"code\": \"ExtensionTypeLimitation\",\n        \"message\": \"string\",\n        \"permission\": \"string\"\n      }\n    },\n    {\n      \"id\": \"string\",\n      \"available\": true,\n      \"params\": [\n        {\n          \"name\": \"string\",\n          \"value\": \"string\"\n        },\n        {\n          \"name\": \"string\",\n          \"value\": \"string\"\n        }\n      ],\n      \"reason\": {\n        \"code\": \"ExtensionTypeLimitation\",\n        \"message\": \"string\",\n        \"permission\": \"string\"\n      }\n    }\n  ]\n}",
