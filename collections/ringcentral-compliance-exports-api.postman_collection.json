          "id": "e14c1866-905f-4671-828c-487a4d9d86a6",
          "name": "Create Data Export Task",
          "request": {
            "name": "Create Data Export Task",
            "description": {
              "content": "Creates a task for Glip data export and returns a link at which the exported data will be available in future once the task is implemented. The exported data can be downloaded by calling Get Data Export Task method with the specified task ID. Simultaneously no more than 2 tasks per company can be created.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "team-messaging",
                "v1",
                "data-export"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
